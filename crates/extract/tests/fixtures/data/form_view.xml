<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The order form, then its search view. -->
    <record id="demo_order_form" model="ir.ui.view">
        <field name="name">demo.order.form</field>
        <field name="model">demo.order</field>
        <field name="arch" type="xml">
            <form string="Order">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"/>
                    <button id="action_confirm" name="action_confirm" string="Confirm &gt; Now" type="object"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title" name="title_div">
                        <h1><field name="name"/></h1>
                    </div>
                    <group name="header">
                        <group name="partner_details">
                            <field name="customer_id"/>
                            <div><field name="order_date"/></div>
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <field name="order_date" invisible="1"/>
                    <t t-if="True"><span id="hint">Hint</span></t>
                </sheet>
            </form>
        </field>
    </record>

    <record id="demo_order_search" model="ir.ui.view">
        <field name="name">demo.order.search</field>
        <field name="model">demo.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="late" string="Late" domain="[('order_date', '&lt;', context_today())]"/>
                <group expand="0" string="Group By">
                    <filter name="group_customer" context="{'group_by': 'customer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Declared again: Odoo updates the record, so the priority joins the first declaration. -->
    <record id="demo_order_form" model="ir.ui.view">
        <field name="priority">20</field>
    </record>
</odoo>
